generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Goal {
  PORTFOLIO
  HACKATHON
  LEARNING
  OPEN_SOURCE
  STARTUP
  LONG_TERM
  SHORT_TERM
}

enum ProjectType {
  PORTFOLIO
  HACKATHON
  STARTUP
  OPEN_SOURCE
  LEARNING
}

enum ProjectStatus {
  RECRUITING
  ACTIVE
  COMPLETED
  PAUSED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  username            String?  @unique
  bio                 String?
  location            String?
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  preferences      UserPreferences?
  skills           UserSkill[]
  interests        UserInterest[]
  goals            UserGoal[]
  ownedProjects    Project[]           @relation("OwnedProjects")
  teamMemberships  TeamMember[]
  joinRequests     JoinRequest[]
  sentInvitations  ProjectInvitation[] @relation("SentInvitations")
  receivedInvitations ProjectInvitation[] @relation("ReceivedInvitations")

  @@map("users")
}

model UserPreferences {
  id                String           @id @default(uuid())
  userId            String           @unique
  availabilityHours Int?
  preferWeekdays    Boolean          @default(false)
  preferWeekends    Boolean          @default(false)
  preferEvenings    Boolean          @default(false)
  preferMornings    Boolean          @default(false)
  experienceLevel   ExperienceLevel?
  githubUrl         String?
  portfolioUrl      String?
  linkedinUrl       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Skill {
  id              String             @id @default(uuid())
  name            String             @unique
  category        String
  userSkills      UserSkill[]
  projectRoleSkills ProjectRoleSkill[]

  @@map("skills")
}

model UserSkill {
  id               String           @id @default(uuid())
  userId           String
  skillId          String
  proficiencyLevel ProficiencyLevel

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  userInterests UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model UserGoal {
  userId String
  goal   Goal

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, goal])
  @@map("user_goals")
}

// ─── Phase 2: Project Discovery ────────────────────────────

model Project {
  id              String        @id @default(uuid())
  ownerId         String
  title           String
  description     String
  domain          String
  projectType     ProjectType
  duration        String
  commitmentHours Int
  maxTeamSize     Int           @default(5)
  status          ProjectStatus @default(RECRUITING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner        User                @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  roles        ProjectRole[]
  teamMembers  TeamMember[]
  joinRequests JoinRequest[]
  invitations  ProjectInvitation[]

  @@map("projects")
}

model ProjectRole {
  id        String             @id @default(uuid())
  projectId String
  roleName  String
  openings  Int                @default(1)

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skills    ProjectRoleSkill[]

  @@map("project_roles")
}

model ProjectRoleSkill {
  projectRoleId String
  skillId       String

  role  ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  skill Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectRoleId, skillId])
  @@map("project_role_skills")
}

model TeamMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("team_members")
}

model JoinRequest {
  id        String        @id @default(uuid())
  projectId String
  userId    String
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("join_requests")
}

// ─── Phase 3: Teammate Discovery & Invitations ─────────────

model ProjectInvitation {
  id         String        @id @default(uuid())
  projectId  String
  senderId   String
  receiverId String
  roleName   String
  message    String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([projectId, receiverId])
  @@map("project_invitations")
}

