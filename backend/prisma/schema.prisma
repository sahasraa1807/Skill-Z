generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Goal {
  PORTFOLIO
  HACKATHON
  LEARNING
  OPEN_SOURCE
  STARTUP
  LONG_TERM
  SHORT_TERM
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  username            String?  @unique
  bio                 String?
  location            String?
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  preferences UserPreferences?
  skills      UserSkill[]
  interests   UserInterest[]
  goals       UserGoal[]

  @@map("users")
}

model UserPreferences {
  id                String           @id @default(uuid())
  userId            String           @unique
  availabilityHours Int?
  preferWeekdays    Boolean          @default(false)
  preferWeekends    Boolean          @default(false)
  preferEvenings    Boolean          @default(false)
  preferMornings    Boolean          @default(false)
  experienceLevel   ExperienceLevel?
  githubUrl         String?
  portfolioUrl      String?
  linkedinUrl       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String
  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id               String           @id @default(uuid())
  userId           String
  skillId          String
  proficiencyLevel ProficiencyLevel

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  userInterests UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model UserGoal {
  userId String
  goal   Goal

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, goal])
  @@map("user_goals")
}
